# Auto detect text files and normalize to LF
* text=auto eol=lf

*.tf     text eol=lf linguist-language=HCL
*.tfvars text eol=lf linguist-language=HCL
*.hcl    text eol=lf linguist-language=HCL
*.md     text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.json   text eol=lf
Makefile text eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
