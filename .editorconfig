root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 2
indent_style = space
insert_final_newline = true
max_line_length = 120
trim_trailing_whitespace = true

[*.{tf,tfvars,hcl}]
indent_size = 2
indent_style = space
max_line_length = off

[*.{yml,yaml}]
indent_size = 2
indent_style = space

[*.{json,jsonc}]
indent_size = 2
indent_style = space

[*.md]
max_line_length = off
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
indent_size = 4
tab_width = 4

[*.sh]
indent_style = space
indent_size = 2

[{COMMIT_EDITMSG,*.diff,*.patch}]
max_line_length = off
